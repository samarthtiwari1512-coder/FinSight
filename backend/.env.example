# FinSight Local Development Environment
# Copy this to .env and modify as needed

# ─── Application ─────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=debug

# ─── Server ──────────────────────────────────────────────────────
PORT=8080
GIN_MODE=debug
ALLOWED_ORIGIN=http://localhost:5173
READ_TIMEOUT_SECONDS=30
WRITE_TIMEOUT_SECONDS=60

# ─── Database ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=finsight
DB_PASSWORD=finsight_dev_password
DB_NAME=finsight
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# ─── Redis ───────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ─────────────────────────────────────────────────────────
# IMPORTANT: Change these in production!
JWT_ACCESS_SECRET=finsight-dev-access-secret-change-in-prod
JWT_REFRESH_SECRET=finsight-dev-refresh-secret-change-in-prod
JWT_ACCESS_EXPIRY_HOURS=8
JWT_REFRESH_EXPIRY_DAYS=30

# ─── FX Rate Provider ────────────────────────────────────────────
# Optional: Get free key from https://www.exchangerate-api.com/
# Without this key, FX rates will use seed data values only
FX_API_KEY=
FX_PROVIDER=EXCHANGERATE_API
FX_UPDATE_INTERVAL_MINUTES=60
FX_STALENESS_MINUTES=120

# ─── Financial Settings ──────────────────────────────────────────
BASE_CURRENCY=INR
COMPANY_NAME=Acme Global Manufacturing Ltd

# ─── Security ────────────────────────────────────────────────────
BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# ─── Monitoring ──────────────────────────────────────────────────
ENABLE_METRICS=true
METRICS_PORT=9090
